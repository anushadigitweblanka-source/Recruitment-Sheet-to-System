DB_HOST=localhost
DB_PORT=5432
DB_NAME=recruitment_system_dev
DB_USER=recruitment_app_dev
DB_PASSWORD=CHANGE_ME
# Leave unset locally. A hosted database needs DB_SSL=true (certificate checked).
# DB_SSL=true
# A company server with its own (private or self-signed) certificate: supply the
# certificate, never switch checking off. The certificate is public, but keep it
# out of Git. DB_SSL_SERVERNAME is only for a certificate issued for a name other
# than the one in DB_HOST.
# DB_SSL_CA=<certificate text, or the same text base64-encoded>
# DB_SSL_SERVERNAME=

# Development sign-in account, created by: npm run db:create-dev-admin
# Use a made-up address, never a real person's. Choose your own password (12+ characters).
DEV_ADMIN_EMAIL=dev.admin@example.com
DEV_ADMIN_NAME=Development Admin
DEV_ADMIN_PASSWORD=CHANGE_ME

# Development only. See documentation. Never commit real values.
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
COMPANY_SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:3000
